#!/usr/bin/env bash
echo -n "Position: "
ansi --report-position || echo "Error"
echo -n "Icon: "
ansi --report-icon || echo "Error"
echo -n "Screen Chars: "
ansi --report-screen-chars || echo "Error"
echo -n "Title: "
ansi --report-title || echo "Error"
echo -n "Window Chars: "
ansi --report-window-chars || echo "Error"
echo -n "Window Pixels: "
ansi --report-window-pixels || echo "Error"
echo -n "Window Position: "
ansi --report-window-position || echo "Error"
echo -n "Window State: "
ansi --report-window-state || echo "Error"

# NOTE: Report commands cannot be used inside subshells like this:
# echo "Position: $(ansi --report-position)"
#
# The reason is that `read -p` sends the terminal query to stdout, and
# the subshell captures stdout. The query never reaches the terminal,
# so no response is received and the command times out.
#
# Instead, capture the result into a variable:
# ansi --report-position
# POSITION="$ANSI_REPORT"
